# Copy this file to .env and fill in real values. Do NOT commit your real .env to source control.

# SMTP (used by Nodemailer). If not set, an Ethereal test account will be used automatically.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false   # true for port 465, false for 587
SMTP_USER=your.smtp.user
SMTP_PASS=enyi viey unrr bdlu
FROM_EMAIL=no-reply@unicafe.local

# Payment provider feature flag (mock or paymongo)
PAYMENT_PROVIDER=mock

# PayMongo (if you decide to integrate later)
PAYMONGO_SECRET=
PAYMONGO_PUBLIC=

# Database (optional for future production migration)
# Example for Postgres: DATABASE_URL=postgres://user:pass@host:5432/unicafe
DATABASE_URL=

# Other
NODE_ENV=development
